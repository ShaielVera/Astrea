# URL base de la API de Astrea (backend .NET)
NEXT_PUBLIC_API_URL=http://localhost:5080/api/v1

# Configuración web de Firebase (Consola de Firebase → Configuración del proyecto → Tus apps).
# Son datos públicos que identifican el proyecto; no son secretos.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Opcional: usar el Firebase Auth Emulator en lugar del proyecto real (ej. http://127.0.0.1:9099)
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_URL=
